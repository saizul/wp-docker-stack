#!/usr/bin/env bash
# Test double for the docker CLI. Records every call and returns canned output.
#   STUB_LOG          file that receives one line per invocation
#   STUB_PS_FILE      output for `compose ps --format ...`
#   STUB_FAIL_MATCH   extended regex; matching invocations exit 1
set -euo pipefail
printf '%s\n' "$*" >> "${STUB_LOG:?STUB_LOG not set}"
if [ -n "${STUB_FAIL_MATCH:-}" ] && [[ "$*" =~ $STUB_FAIL_MATCH ]]; then
  echo "docker stub: simulated failure" >&2
  exit 1
fi
case " $* " in
  *" ps "*"--format"*)
    if [ -n "${STUB_PS_FILE:-}" ] && [ -f "$STUB_PS_FILE" ]; then cat "$STUB_PS_FILE"; fi
    ;;
  *" backup.sh run "*) echo "20260101T033000Z" ;;
  *" backup.sh list "*) printf '%s\n' 20260102T033000Z 20260101T033000Z ;;
esac
exit 0
