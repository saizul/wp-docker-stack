# Rendered by the nginx image entrypoint (envsubst, NGINX_* variables only).

fastcgi_cache_path /var/cache/nginx/fastcgi levels=1:2 keys_zone=WORDPRESS:64m
                   max_size=${NGINX_CACHE_MAX_SIZE} inactive=60m use_temp_path=off;
fastcgi_cache_key "$http_x_forwarded_proto$request_method$host$request_uri";
# 302s are not cached: WordPress uses them for logins and the installer redirect.
fastcgi_cache_valid 200 301 ${NGINX_CACHE_VALID};
fastcgi_cache_valid 404 1m;
fastcgi_cache_use_stale error timeout updating invalid_header http_500 http_503;
fastcgi_cache_background_update on;
fastcgi_cache_lock on;

# --- Page cache bypass rules -----------------------------------------------------
map $http_cookie $wpstack_cookie_skip {
    default 0;
    "~*wordpress_logged_in_|wordpress_sec_|wp-postpass_|comment_author_|woocommerce_items_in_cart|wp_woocommerce_session_|edd_items_in_cart" 1;
}
map $request_method $wpstack_method_skip {
    default 1;
    GET 0;
    HEAD 0;
}
map $request_uri $wpstack_uri_skip {
    default 0;
    "~*^/(wp-admin|wp-login\.php|wp-json|xmlrpc\.php|wp-cron\.php|wp-signup\.php|wp-activate\.php)" 1;
    "~*/(feed|cart|checkout|my-account|basket)(/|$)" 1;
    "~*sitemap(_index)?\.xml" 1;
}
map $args $wpstack_args_skip {
    default 1;
    "" 0;
}
map "${NGINX_FASTCGI_CACHE}:$wpstack_cookie_skip:$wpstack_method_skip:$wpstack_uri_skip:$wpstack_args_skip" $wpstack_skip_cache {
    default 1;
    "on:0:0:0:0" 0;
}
map "${NGINX_BLOCK_XMLRPC}" $wpstack_block_xmlrpc {
    default 1;
    off 0;
}
map $http_x_forwarded_proto $wpstack_https {
    default "";
    https on;
}

server {
    listen 8080 default_server;
    server_name _;
    root /var/www/html;
    index index.php;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY};

    set_real_ip_from ${NGINX_REAL_IP_FROM};
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    include /etc/nginx/snippets/security-headers.conf;

    location = /nginx-health {
        access_log off;
        allow 127.0.0.1;
        deny all;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /favicon.ico { log_not_found off; access_log off; try_files $uri =204; }
    location = /robots.txt  { log_not_found off; access_log off; try_files $uri /index.php?$args; }

    # Hidden files (.git, .env, .htaccess), except ACME challenges.
    location ~ /\.(?!well-known/) { deny all; }

    # Files that must never be served.
    location ~* ^/(wp-config\.php|wp-config-docker\.php|wp-config-sample\.php|readme\.html|license\.txt)$ { deny all; }
    location ~* \.(sql|sql\.gz|bak|old|orig|swp|log|ini|sh)$ { deny all; }

    # No PHP execution in uploads or wp-includes (except the TinyMCE loader).
    location ~* ^/wp-content/uploads/.*\.(php|phtml|phar|pl|py|cgi)$ { deny all; }
    location ~* ^/wp-includes/(?!js/tinymce/wp-tinymce\.php$).+\.php$ { deny all; }

    location = /xmlrpc.php {
        if ($wpstack_block_xmlrpc) { return 403; }
        include /etc/nginx/snippets/fastcgi-php.conf;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~* \.(?:css|js|mjs|map|jpg|jpeg|png|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|mp4|webm|ogg|mp3|pdf)$ {
        expires 30d;
        access_log off;
        try_files $uri /index.php?$args;
    }

    location ~ \.php$ {
        include /etc/nginx/snippets/fastcgi-php.conf;
    }
}
