# wp-docker-stack configuration. `make init` copies this file to .env and
# generates random secrets in ./secrets/. Never commit .env or ./secrets/.

# --- Project -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=wpstack
# Optional TLS front end: leave empty (bring your own proxy), "caddy" or "traefik".
COMPOSE_PROFILES=

# Public hostname and URL of the site.
DOMAIN=localhost
WP_URL=http://localhost:8080
# Email for Let's Encrypt (Caddy/Traefik profiles).
ACME_EMAIL=

# --- Published port ------------------------------------------------------------
# nginx is published on HTTP_BIND:HTTP_PORT. The default binds to localhost only,
# for use behind a host-level proxy or the caddy/traefik profile.
# Set HTTP_BIND=0.0.0.0 and HTTP_PORT=80 to serve plain HTTP directly.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# --- Images (official images, pinned to a minor version) ----------------------
WORDPRESS_BASE_IMAGE=wordpress:7.1-php8.4-fpm-alpine
NGINX_IMAGE=nginx:1.30-alpine
MARIADB_IMAGE=mariadb:11.8
REDIS_IMAGE=redis:8.8-alpine
CADDY_IMAGE=caddy:2.11-alpine
TRAEFIK_IMAGE=traefik:v3.7
BACKUP_BASE_IMAGE=alpine:3.24

# --- Database --------------------------------------------------------------------
DB_NAME=wordpress
DB_USER=wordpress
DB_TABLE_PREFIX=wp_
DB_INNODB_BUFFER_POOL=256M
DB_MAX_CONNECTIONS=100

# --- PHP ---------------------------------------------------------------------------
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX=64M
PHP_MAX_EXECUTION_TIME=120
PHP_FPM_MAX_CHILDREN=10
PHP_FPM_START_SERVERS=3
PHP_FPM_MIN_SPARE=2
PHP_FPM_MAX_SPARE=5
PHP_FPM_MAX_REQUESTS=500
PHP_OPCACHE_MEMORY=192
# Leave empty for production; set to 1 to enable WP_DEBUG.
WP_DEBUG=

# --- nginx -------------------------------------------------------------------------
NGINX_FASTCGI_CACHE=on
NGINX_CACHE_VALID=10m
NGINX_CACHE_MAX_SIZE=512m
NGINX_BLOCK_XMLRPC=on
# Trusted proxy range for X-Forwarded-For (Docker networks by default).
NGINX_REAL_IP_FROM=172.16.0.0/12

# --- Redis -------------------------------------------------------------------------
REDIS_MAXMEMORY=256mb

# --- WP-Cron (runs from the cron container; WP-Cron is disabled in WordPress) -----
WP_CRON_INTERVAL=60

# --- Backups -----------------------------------------------------------------------
# Daily backup time (UTC, HH:MM) and number of local backups to keep.
BACKUP_TIME=03:30
BACKUP_KEEP=7
BACKUP_ON_START=false
# Optional off-site copy with rclone: "none" or "s3" (works for Cloudflare R2,
# AWS S3, Backblaze B2 S3, MinIO, Wasabi, ...).
BACKUP_OFFSITE=none
S3_PROVIDER=Cloudflare
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PREFIX=wordpress
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Resource limits -------------------------------------------------------------
LIMIT_PHP_MEM=1g
LIMIT_PHP_CPUS=2
LIMIT_DB_MEM=1g
LIMIT_DB_CPUS=2
LIMIT_NGINX_MEM=256m
LIMIT_REDIS_MEM=384m
LIMIT_CRON_MEM=512m
LIMIT_BACKUP_MEM=512m
