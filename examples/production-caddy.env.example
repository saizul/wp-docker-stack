# Example production values (merge into your .env). Secrets are created by
# `make init` into ./secrets/ and are not part of this file.
COMPOSE_PROJECT_NAME=blog
COMPOSE_PROFILES=caddy
DOMAIN=blog.example.com
WP_URL=https://blog.example.com
ACME_EMAIL=ops@example.com

# nginx stays on localhost; Caddy terminates TLS on :80/:443.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

PHP_FPM_MAX_CHILDREN=20
LIMIT_PHP_MEM=2g
DB_INNODB_BUFFER_POOL=512M
LIMIT_DB_MEM=1536m

# Nightly backup at 02:15 UTC, 14 local copies, plus an off-site copy to Cloudflare R2.
BACKUP_TIME=02:15
BACKUP_KEEP=14
BACKUP_OFFSITE=s3
S3_PROVIDER=Cloudflare
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=blog-backups
S3_PREFIX=blog.example.com
# Fill these in your real .env only (R2 API token with Object Read & Write):
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
